# Xdebug MCP Server Configuration

# DBGp Server Configuration
# Port to listen for Xdebug connections (default: 9003)
XDEBUG_PORT=9003

# Host to bind. Defaults to 127.0.0.1. DBGp has no authentication, so only
# widen this when an engine must reach the listener from another host (for
# example a Docker container), and set XDEBUG_IDEKEY when you do.
XDEBUG_HOST=127.0.0.1

# Require this IDE key on inbound debug sessions. Sessions presenting any
# other key are rejected. Strongly recommended whenever XDEBUG_HOST is not
# loopback. Must match xdebug.idekey in the PHP process.
# XDEBUG_IDEKEY=mcp

# Reject a DBGp message declaring more than this many bytes (default 16777216)
# MAX_MESSAGE_LENGTH=16777216

# Drop a connection that has not sent its init packet within this many ms
# HANDSHAKE_TIMEOUT=30000

# Optional DBGp proxy registration (TCP listener mode only)
# When using a proxy on 9003, set XDEBUG_PORT to a separate callback port such as 9006
# DBGP_PROXY_HOST=127.0.0.1
# DBGP_PROXY_PORT=9001
# DBGP_IDEKEY=mcp
# DBGP_PROXY_ALLOW_FALLBACK=false

# Command timeout in milliseconds (default: 30000)
COMMAND_TIMEOUT=30000

# Path mappings from Docker container to host (JSON format)
# Example: Maps /var/www/html in container to /home/user/projects/myapp on host
# PATH_MAPPINGS='{ "/var/www/html": "/home/user/projects/myapp" }'

# Variable inspection limits
MAX_DEPTH=3
MAX_CHILDREN=128
MAX_DATA=2048

# Logging level: debug, info, warn, error
LOG_LEVEL=info
